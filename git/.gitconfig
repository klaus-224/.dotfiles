[core]
	editor = nvim
	excludesfile = /Users/klaus224/.gitignore_global

[diff]
  tool = nvimdiff

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true  
		side-by-side = true
		line-numbers = true

[merge]
    tool = nvimdiff
    conflictStyle = zdiff3

[init]
	defaultBranch = main

[pull]
	rebase = true
	ff = only

[push]
	autoSetupRemote = true

[alias]
	lg = log --oneline --graph --decorate

[include]
	path = ~/.gitconfig.local
