#!/bin/sh

# Validate destination branch names, not HEAD or the local source ref.
# Tags, other namespaces, and deletions have no branch-name policy here.
LC_ALL=C
export LC_ALL
pattern='^(main|develop|(feat|fix|chore|refactor|docs|test|style)/[a-z0-9._-]+)$'
status=0
while read -r local_ref local_oid remote_ref remote_oid extra; do
  if [ -z "$local_ref" ] || [ -z "$local_oid" ] || [ -z "$remote_ref" ] ||
     [ -z "$remote_oid" ] || [ -n "$extra" ]; then
    printf '%s\n' 'Malformed pre-push ref input; refusing push.' >&2
    exit 1
  fi
  # All-zero object IDs work for both SHA-1 and SHA-256 repositories.
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  case "$remote_ref" in
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      if ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
        printf 'Invalid destination branch name: %s\n' "$branch" >&2
        printf '%s\n' 'Expected main, develop, or feat|fix|docs|style|refactor|test|chore/<lowercase-name>.' >&2
        status=1
      fi
      ;;
  esac
done
exit "$status"
