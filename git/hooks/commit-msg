#!/bin/sh

LC_ALL=C
export LC_ALL
if [ "$#" -ne 1 ] || [ ! -f "$1" ] || [ ! -r "$1" ]; then
  printf '%s\n' 'Expected a readable commit-message file.' >&2
  exit 1
fi
message=
IFS= read -r message < "$1" || :

pattern='^(feat|fix|docs|style|refactor|test|chore)(\([a-z0-9._-]+\))?!?: .*[^[:space:]].*$'

if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  printf 'Invalid commit message:\n  %s\n\n' "$message" >&2
  printf '%s\n' 'Expected:' '  feat: add authentication' '  fix(api): handle missing user' >&2
  exit 1
fi
