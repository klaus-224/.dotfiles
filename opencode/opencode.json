{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "default": {
      "model": "anthropic/claude-sonnet-4-5"
    },

    "opencode-expert": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "webfetch": "allow",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "mkdir *": "ask",
          "cp *": "ask",
          "mv *": "ask",
          "ln *": "ask",
          "git status*": "allow",
          "git diff*": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },

    "workflow-orchestrator": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "git status*": "allow",
          "git diff*": "allow"
        },
        "task": {
          "*": "deny",
          "workflow-planner": "allow",
          "workflow-executor": "allow",
          "workflow-reviewer": "allow"
        }
      }
    },

    "workflow-planner": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "webfetch": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "git status*": "allow",
          "git diff*": "allow"
        }
      }
    },

    "workflow-executor": {
      "mode": "subagent",
      "permission": {
        "edit": "ask",
        "webfetch": "deny",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git add *": "ask",
          "git commit *": "ask",
          "pytest *": "ask",
          "uv run *": "ask",
          "npm test *": "ask",
          "pnpm test *": "ask",
          "make test *": "ask"
        }
      }
    },

    "workflow-reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "cat *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  },
}
