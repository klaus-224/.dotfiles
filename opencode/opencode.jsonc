{
	"$schema": "https://opencode.ai/config.json",
	"disabled_providers": [
		"opencode",
		"openai"
	],
	"skills": {
		"paths": [
			"./skills"
		]
	},
	"tools": {
		"paths": true
	},
	"mcp": {
		"atlassian": {
			"type": "remote",
			"url": "https://mcp.atlassian.com/v1/mcp",
			"enabled": true
		}
	},
	"plugin": [
		"@mohak34/opencode-notifier@latest",
		"@plannotator/opencode@latest",
		"opentmux"
	]
}
