{
	"$schema": "https://opencode.ai/config.json",
	"disabled_providers": [
		"opencode",
		"openai"
	],
	"skills": {
		"paths": [
			"./skills"
		]
	},
	"mcp": {
		"atlassian": {
			"type": "remote",
			"url": "https://mcp.atlassian.com/v1/mcp",
			"enabled": true
		}
	},
	"tools": {
		"jira_*": false
	},
	"command": {
		"plan-start": {
			"description": "Create or continue a collaborative plan",
			"agent": "code-planner",
			"subtask": true,
			"template": "Load the plan-store skill. Create or continue a plan for: $ARGUMENTS. Use the database as source of truth. End by transitioning ownership appropriately."
		},
		"plan-review": {
			"description": "Review the current plan state and approve or return feedback",
			"agent": "code-plan-reviewer",
			"subtask": true,
			"template": "Load the plan-store skill. Review the plan for: $ARGUMENTS. Add comments, then either approve or transition it back to drafting."
		},
		"plan-execute": {
			"description": "Execute work from an approved plan",
			"agent": "code-implementer",
			"subtask": true,
			"template": "Load the plan-store skill. Fetch the approved plan for: $ARGUMENTS, transition to executing, and work only from approved scope."
		}
	},
	"agent": {
		"default": {
			"model": "github-copilot/claude-opus-4.6"
		},
		"opencode-expert": {
			"mode": "primary",
			"permission": {
				"edit": "ask",
				"webfetch": "allow",
				"bash": {
					"*": "ask",
					"pwd": "allow",
					"ls *": "allow",
					"find *": "allow",
					"rg *": "allow",
					"cat *": "allow",
					"mkdir *": "ask",
					"cp *": "ask",
					"mv *": "ask",
					"ln *": "ask",
					"git status*": "allow",
					"git diff*": "allow"
				},
				"task": {
					"*": "deny"
				}
			}
		}
	},
}
