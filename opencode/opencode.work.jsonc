{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.4",
  "disabled_providers": ["opencode", "openai"],
  "skills": {
    "paths": ["./skills"],
  },
  "tools": {
    "paths": true,
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true,
    },
  },
  "plugin": ["@plannotator/opencode@latest"],
}
