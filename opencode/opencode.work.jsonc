{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.5",
  "default_agent": "pair-programmer",
  "disabled_providers": ["opencode", "openai"],
  "skills": {
    "paths": ["./skills"]
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    }
  },
  "agent": {
    // Pair Programming Agent
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.5",
      "prompt": "{file:./agent-defs/pair-programmer.md}",
      "tools": {
        "repo_query": true,
        "repo_search": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "bash": {
          "repo query *": "allow",
          "repo search *": "allow",
          "playwright_docs search *": "allow"
        }
      }
    },

    // Review Agent
    "reviewer": {
      "description": "Reviews regression test plans and implementations collaboratively with the user, recording preferences as memory",
      "mode": "primary",
      "model": "github-copilot/claude-opus-4.6",
      "prompt": "{file:./agent-defs/reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "playwright-docs search": "allow",
        "skill": { "*": "deny", "playwright-docs": "allow" },
        "plan_get": "allow",
        "memory_query": "allow",
        "memory_add": "allow",
        "repo_query": "allow",
        "session_list": "allow",
        "session_transcript": "allow",
        "session_list_flagged": "allow",
        "session_resolve": "allow"
      }
    },

    // Building Agent
    "build": {
      "model": "github-copilot/gpt-5.4",
      "mode": "primary",
      "tools": {
        "repo_query": true,
        "repo_search": true,
        "paths": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": { "*": "deny" },
        "bash": {
          "*": "deny",
          "git *": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "node *": "allow",
          "npx *": "allow",
          "tsc *": "allow",
          "eslint *": "allow",
          "prettier *": "allow",
          "docker *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "rm *": "ask"
        }
      }
    },

    "planner": {
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "model": "github-copilot/claude-opus-4.6",
      "prompt": "{file:./prompts/planner.txt}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "repo_query": "allow",
        "repo_index": "allow",
        "memory_query": "allow",
        "skill": { "*": "deny", "plannotator-compound": "allow" },
        "edit": { "*": "deny", "*.md": "allow" },
        "external_directory": "deny"
      }
    },

    // Jira Operator
    "jira-operator": {
      "description": "General-purpose Jira operator for querying, creating, transitioning, commenting, and linking issues via the Jira MCP.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "prompt": "{file:./agent-defs/jira-operator.md}",
      "permission": {
        // "atlassian_search": "allow",
        // "atlassian_createJiraIssue": "allow",
        // "atlassian_editJiraIssue": "allow",
        // "atlassian_transitionJiraIssue": "allow",
        // "atlassian_addWorklogToJiraIssue": "allow",
        // "atlassian_createIssueLink": "allow",
        // "atlassian_lookupJiraAccountId": "allow",
        // "atlassian_getVisibleJiraProjects": "allow",
        // "atlassian_getJiraProjectIssueTypesMetadata": "allow",
        // "atlassian_getJiraIssueTypeMetaWithFields": "allow",
        // "atlassian_getIssueLinkTypes": "allow",
        // "atlassian_getJiraIssueRemoteIssueLinks": "allow",
        // "atlassian_fetch": "allow"

        "*": "deny",
        "read": "allow",
        "todowrite": "allow",

        // title, description, comments, status, assignee
        "atlassian_getJiraIssue": "allow",
        // add comment to ticket
        "atlassian_addCommentToJiraIssue": "allow",
        "atlassian_getAccessibleAtlassianResources": "allow", //
        // jira key, short title, ticket link
        "atlassian_searchJiraIssuesUsingJql": "allow",
        // get GH pr number and link
        "atlassian_getJiraIssueDevelopmentInfo": "allow",
        //
        "atlassian_lookupJiraAccountId": "allow"
      }
    },

    // Manual PW tester
    "manual-tester": {
      "description": "Plans and executes manual tests for Jira tickets.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "prompt": "{file:./agent-defs/manual-tester.md}",
      "tools": {
        "*": false,
        "repo_query": true,
        "repo_search": true,
        "memory_query": true,
        "memory_search": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "session_flag_current": "allow",
        "skill": {
          "*": "deny",
          "playwright-cli": "allow",
          "plannotator-annotate": "allow"
        },
        "task": { "*": "deny", "jira-operator": "allow" },
        "bash": {
          "*": "deny",
          "pnpm -C apps/playwright-tests auth": "allow",
          // "playwright_docs search *": "allow",
          "playwright-cli *": "allow",
          "git fetch": "allow",
          "gh pr list *": "allow",
          "gh pr diff *": "allow",
          "gh pr view *": "allow"
        }
      }
    },

    // Regression Test Planner
    "regression-planner": {
      "description": "Plans regression tests from multiple perspectives, then debates and converges on the best plan with other planner instances",
      "mode": "subagent",
      "model": "github-copilot/claude-opus-4.6",
      "prompt": "{file:./agent-defs/regression-planner.md}",
      "tools": {
        "repo_index": true,
        "repo_query": true,
        "memory_query": true,
        "memory_add": true,
        "playwright-docs_search": true,
        "session_flag_current": true,
        "plan_get": true,
        "plan_revise": true,
        "plan_transition": true,
        "plan_claim": true,
        "plan_release": true,
        "plan_comment": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "deny",
          "playwright-cli": "allow",
          "playwright-docs": "allow",
          "plannotator-annotate": "allow"
        },
        "bash": {
          "*": "deny"
        },
        "atlassian_getJiraIssue": "allow",
        "atlassian_getJiraIssueRemoteIssueLinks": "allow",
        "atlassian_searchJiraIssuesUsingJql": "allow"
      }
    },

    "regression-writer": {
      "description": "Implements approved regression test plans as Playwright test files and verifies they pass",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.4",
      "prompt": "{file:./agent-defs/regression-writer.md}",
      "tools": {
        "repo_index": true,
        "repo_query": true,
        "memory_query": true,
        "memory_add": true,
        "playwright-docs search": true,
        "session_flag_current": true,
        "plan_get": true,
        "plan_revise": true,
        "plan_transition": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "deny",
          "playwright-cli": "allow"
        },
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "pnpm auth": "allow",
          "pnpm test:regression *": "allow",
          "pnpm test:folder *": "allow",
          "pnpm test *": "allow"
        }
      }
    },

    // hidden base agents
    "general": {
      "hidden": true
    },

    "plan": {
      "hidden": true
    }
  },

  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner, test-planner"]
      }
    ]
  ]
}
