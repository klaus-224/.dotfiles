{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "autoupdate": true,
  "default_agent": "pair-programmer",
  "enabled_providers": ["github-copilot"],
  "disabled_providers": ["opencode", "openai"],
  "skills": {
    "paths": ["./skills"]
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    }
  },
  "agent": {
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "medium",
      "prompt": "{file:./agent-defs/pair-programmer.md}",
      "skill": {
        "*": "deny",
        "find-docs": "allow"
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "allow"
        }
      }
    },
    // Review Agent
    "reviewer": {
      "description": "Reviews test plans and implementations collaboratively with the user, recording preferences as memory",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./agent-defs/reviewer.md}",
      "tools": {
        "*": false,
        "project_index_search": true,
        "project_index_index": true,
        "project_index_query": true,
        "memory_query": true,
        "memory_add": true
      },
      "skill": {
        "*": "deny",
        "playwright-cli": "allow",
        "plannotator-annotate": "allow"
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "playwright-docs search": "allow",
        "bash": {
          "memory *": "allow",
          "session *": "allow",
          "project_index *": "allow",
          // "playwright-cli *": "allow",
          "playwright_docs search *": "allow"
        }
      }
    },
    // Building Agent
    "build": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "high",
      "mode": "primary",
      "tools": {
        "project_index_search": true,
        "project_index_index": true,
        "project_index_query": true,
        "memory_query": true,
        "paths": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": {
          "*": "deny"
        },
        "session_reader *": "allow",
        "bash": {
          "*": "deny",
          "python *": "allow",
          "python3 *": "allow",
          "cargo *": "allow",
          "session_reader *": "allow",
          "project_index *": "allow",
          "git *": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "node *": "allow",
          "npx *": "allow",
          "tsc *": "allow",
          "eslint *": "allow",
          "prettier *": "allow",
          "docker *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "rm *": "ask"
        }
      }
    },
    "planner": {
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high",
      "prompt": "{file:./prompts/planner.txt}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "memory_query": "allow",
        "skill": {
          "*": "deny",
          "plannotator-compound": "allow"
        },
        "edit": {
          "*": "deny",
          "*.md": "allow"
        },
        "external_directory": "deny",
        "bash": {
          "cargo": "allow"
        }
      }
    },
    // Jira Operator
    "jira-operator": {
      "description": "General-purpose Jira operator for querying, creating, transitioning, commenting, and linking issues via the Jira MCP.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "low",
      "prompt": "{file:./agent-defs/jira-operator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "atlassian_getJiraIssue": "allow",
        "atlassian_addCommentToJiraIssue": "allow",
        "atlassian_getAccessibleAtlassianResources": "allow", //
        "atlassian_searchJiraIssuesUsingJql": "allow",
        "atlassian_getJiraIssueDevelopmentInfo": "allow",
        "atlassian_lookupJiraAccountId": "allow"
      }
    },
    "playwright-user": {
      "description": "executes manual tests",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-luna",
      "prompt": "{file:./agent-defs/playwright-user.md}",
      "tools": {
        "*": true,
        // "memory_query": true,
        // "memory_search": true,
        "session_flag_current": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "skill": {
          "*": "deny",
          "plannotator-annotate": "allow"
          // "playwright-cli": "allow",
        },
        "task": {
          "*": "deny",
          "jira-operator": "allow"
        },
        "bash": {
          "*": "ask",
          "gh pr *": "allow",
          "git *": "allow",
          "rg *": "allow",
          "pnpm -C apps/playwright-tests auth": "allow"
          // "playwright-cli *": "allow",
          // "session *": "allow",
          // "memory *": "allow",
        }
      }
    },
    // Regression Test Planner
    "regression-planner": {
      "description": "Plans regression tests from multiple perspectives, then debates and converges on the best plan with other planner instances",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./agent-defs/regression-planner.md}",
      "tools": {
        "project_index": true,
        "memory_query": true,
        "memory_add": true,
        "playwright-docs_search": true,
        "session_flag_current": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "deny",
          "plannotator": "allow"
        },
        "atlassian_getJiraIssue": "allow",
        "atlassian_getJiraIssueRemoteIssueLinks": "allow",
        "atlassian_searchJiraIssuesUsingJql": "allow"
      }
    },
    "regression-writer": {
      "description": "Implements approved regression test plans as Playwright test files and verifies they pass",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-terra",
      "variant": "medium",
      "prompt": "{file:./agent-defs/regression-writer.md}",
      "tools": {
        "project_index": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "deny"
          // "playwright-cli": "allow"
        },
        "bash": {
          "*": "deny",
          "git": "allow",
          "pnpm auth": "allow"
        }
      }
    },
    "general": {
      "hidden": true
    },
    "plan": {
      "hidden": true
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner, test-planner"]
      }
    ]
  ]
}
