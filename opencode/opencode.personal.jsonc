{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-5.6-luna",
  "default_agent": "pair-programmer",
  "enabled_providers": ["openai", "opencode"],
  "skills": {
    "paths": ["./skills"]
  },
  "permission": {
    "webfetch": "deny",
    "external_directory": "deny"
  },
  "agent": {
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/chat.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "skill": {
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny"
        }
      }
    },
    "build": {
      "description": "Implementation agent for explicitly requested code changes.",
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny",
          "rg *": "allow",
          "ls *": "allow",
          "git *": "allow",
          "pnpm *": "allow"
        }
      }
    },
    "planner": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "prompt": "{file:./prompts/planner.txt}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "skill": {
          "*": "deny",
          "plannotator-compound": "allow",
          "find-docs": "allow"
        },
        "bash": "deny",
        "external_directory": "deny"
      }
    },
    "orchestrator": {
      "description": "Read-only command-scoped coordinator for evidence-backed planning workflows.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "pr_context_get": "allow",
        "submit_plan": "allow",
        "skill": {
          "*": "deny",
          "test-planning": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "oracle": "allow"
        },
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    },
    "explorer": {
      "description": "Read-only repository discovery specialist with no shell or delegation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "prompt": "{file:./prompts/explorer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "external_directory": "deny"
      }
    },
    "oracle": {
      "description": "Read-only test-plan drafting and critique specialist with no shell or delegation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/oracle.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": {
          "*": "deny",
          "test-planning": "allow"
        },
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "external_directory": "deny"
      }
    },
    "general": {
      "description": "Built-in general-purpose subagent (hidden).",
      "mode": "subagent",
      "hidden": true
    },
    "plan": {
      "description": "Built-in planning agent.",
      "mode": "primary",
      "hidden": true
    }
  },
  "command": {
    "test-plan": {
      "description": "Create a PR test plan limited to explicitly selected test types",
      "agent": "orchestrator",
      "template": "{file:./prompts/test-plan.md}"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@0.27.12",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner", "orchestrator"]
      }
    ]
  ]
}
