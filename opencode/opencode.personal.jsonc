{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "autoupdate": true,
  "default_agent": "chat",
  "enabled_providers": [
    "openai",
    "opencode"
  ],
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "shell": "zsh",
  // use builtin opencode formatter 
  "formatter": true,
  // use builtin opencode lsp 
  "lsp": {
    "typescript": {
      "command": [
        "tsc",
        "--no-emit"
      ]
    },
    "lua": {
      "command": [
        "lua-language-server"
      ],
    },
    "nix": {
      "command": [
        "nixd"
      ],
    },
  },
  "references": {
    "nvim-config": {
      "path": "~/.dotfiles/nvim",
      "description": "My personal neovim config. Use when asked about neovim or nvim"
    },
    "nix": {
      "path": "~/.dotfiles/nix",
      "description": "My personal nix config. Use when asked about nix"
    },
    "zsh": {
      "path": "~/.dotfiles/zsh",
      "description": "My personal zsh config. Use when asked about zsh"
    },
  },
  "plugin": [
    [
      "@plannotator/opencode@0.27.12",
      {
        "workflow": [
          "plan-agent"
        ],
        "planningAgents": [
          "planner",
        ]
      }
    ],
  ],
  "agent": {
    "chat": {
      "description": "Chat and collaboration agent.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 3,
      "prompt": "{file:./prompts/chat.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "ask"
        }
      }
    },
    "planner": {
      "description": "Produces evidence-backed implementation plans and submits them for human approval before code changes begin.",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "mode": "primary",
      "prompt": "{file:./prompts/planner.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "edit": "deny",
        "write": "deny",
        "webfetch": "allow",
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "skill": {
          "plannotator-annotate": "allow",
        },
        "bash": "deny",
        "external_directory": "ask"
      }
    },
    "explorer": {
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "prompt": "{file:./prompts/explorer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "skill": {
          "*": "deny",
          "find-docs": "allow"
        },
        "bash": {
          "*": "deny",
          "ctx7 library *": "allow",
          "ctx7 docs *": "allow"
        },
        "task": "deny",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "external_directory": "deny"
      }
    },
    "builder": {
      "prompt": "{file:./prompts/builder.md}",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "plannotator-review": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git add -A*": "deny",
          "git add --all*": "deny",
          "git add .*": "deny",
          "git commit*--amend*": "deny",
          "git commit*--no-verify*": "deny",
          "just*": "allow",
<<<<<<< HEAD
          "ctx7 library*": "allow",
          "ctx7 docs*": "allow",
=======
          "ctx7 *": "allow",
>>>>>>> 3ae168d (refactor(agents): plannotator perms)
          "plannotator review *": "allow",
        }
      },
    },
    "audit-orchestrator": {
      "description": "Coordinates approved configuration audits in isolated worktrees.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "reasoning": "high",
      "prompt": "{file:./prompts/audit-orchestrator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "doom_loop": "ask",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "task": {
          "*": "deny",
          "audit-worker": "allow"
        },
        "external_directory": {
          "*": "deny",
          "~/.dotfiles/**": "allow",
          "~/code/dotfiles-audit": "allow",
          "~/code/dotfiles-audit/**": "allow"
        },
        "bash": {
          "*": "ask",
          "mkdir": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git worktree list*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "git reset*": "deny",
          "git * reset*": "deny",
          "git clean*": "deny",
          "git * clean*": "deny"
        }
      }
    },
    "audit-worker": {
      "description": "Implements only assigned audit checkpoints without further delegation.",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./prompts/audit-worker.md}",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "doom_loop": "ask",
        "task": "deny",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "external_directory": {
          "*": "deny",
        },
        "bash": {
          "*": "ask",
          "mkdir": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "git reset*": "deny",
          "git * reset*": "deny",
          "git clean*": "deny",
          "git * clean*": "deny",
          "ctx7 library *": "allow",
          "ctx7 docs *": "allow",
          "plannotator review --commit *": "allow",
          "plannotator review --branch *": "allow"
        }
      }
    },
    "general": {
      "hidden": true
    },
    "build": {
      "hidden": true
    },
    "plan": {
      "hidden": true
    }
  },
}
