{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "default_agent": "pair-programmer",
  "enabled_providers": ["openai", "opencode"],
  "skills": {
    "paths": ["./skills"]
  },
  "agent": {
    // Pair Programming Agent
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "variant": "high",
      "prompt": "{file:./agent-defs/pair-programmer.md}",
      "tools": {
        "repo_query": true,
        "repo_search": true,
        "memory_query": true,
        "memory_add": true
      },
      "permission": {
        "*": "deny",
        "todowrite": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "read": "allow",
          "repo query *": "allow",
          "repo search *": "allow"
        }
      }
    },

    "build": {
      "model": "openai/gpt-5.3-codex",
      "mode": "primary",
      "tools": {
        "repo_query": true,
        "repo_search": true,
        "paths": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": { "*": "deny" },
        "bash": {
          "*": "deny",
          "git *": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "node *": "allow",
          "npx *": "allow",
          "tsc *": "allow",
          "eslint *": "allow",
          "prettier *": "allow",
          "docker *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "rm *": "ask"
        }
      }
    },

    "planner": {
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "variant": "high",
      "prompt": "Help me plan whatever I ask. Always load the plannotator-compound skill before submitting any plan. You are not allowed to make edits, you only plan and submit_plan",
      "permission": {
        "submit_plan": "allow",
        "todowrite": "allow",
        "edit": {
          "*": "deny",
          "*.md": "allow"
        },
        "skill": {},
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "allow",
          "grep *": "allow"
        },
        "external_directory": "deny"
      }
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner"]
      }
    ]
  ]
}
