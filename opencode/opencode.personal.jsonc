{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "default_agent": "pair-programmer",
  "enabled_providers": ["openai", "opencode"],
  "skills": {
    "paths": ["./skills"]
  },
  "agent": {
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./agent-defs/pair-programmer.md}",
      "permission": {
        "*": "deny",
        "todowrite": "allow",
        "webfetch": "allow",
        "skill": {
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny",
          "read": "allow",
          "grep *": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny",
          "git *": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "node *": "allow",
          "npx *": "allow",
          "tsc *": "allow",
          "eslint *": "allow",
          "prettier *": "allow",
          "docker *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "cargo *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "rm *": "ask"
        }
      }
    },
    "planner": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "prompt": "Help me plan whatever I ask. Always load the plannotator-compound skill before submitting any plan. You are not allowed to make edits, you only plan and submit_plan",
      "permission": {
        "todowrite": "allow",
        "edit": {
          "*": "deny",
          "*.md": "allow"
        },
        "skill": {
          "plannotator-compound": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "allow",
          "grep *": "allow"
        },
        "external_directory": "deny"
      }
    },
    "general": {
      "hidden": true
    },
    "plan": {
      "hidden": true
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner"]
      }
    ]
  ]
}
