{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "default_agent": "pair-programmer",
  "enabled_providers": ["openai", "opencode"],
  "skills": {
    "paths": ["./skills"]
  },
  "agent": {
    "pair-programmer": {
      "description": "Pair-programming and collaboration agent for chatting through problems.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./agent-defs/pair-programmer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "skill": {
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "find-docs": "allow",
          "simple-coding": "allow"
        },
        "bash": {
          "*": "deny",
          "rg *": "allow",
          "ls *": "allow",
          "git *": "allow",
          "pnpm *": "allow"
        }
      }
    },
    "planner": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "description": "Read-only planning agent for work tickets, PRs, and implementation plans.",
      "mode": "primary",
      "prompt": "Help me plan whatever I ask. Always load the plannotator-compound skill before submitting any plan. You are not allowed to make edits, you only plan and submit_plan",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "submit_plan": "allow",
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "skill": {
          "*": "deny",
          "plannotator-compound": "allow",
          "find-docs": "allow"
        },
        "bash": "deny",
        "external_directory": "deny"
      }
    },
    "general": {
      "hidden": true
    },
    "plan": {
      "hidden": true
    }
  },
  "plugin": [
    "oh-my-opencode-slim@2.2.18",
    [
      "@plannotator/opencode@0.27.12",
      {
        "workflow": "user-managed",
        "planningAgents": ["planner", "orchestrator"]
      }
    ]
  ]
}
