{
  "settings": {
    "default_agent": "chat",
    "lsp": {
      "lua": {
        "command": [
          "lua-language-server"
        ]
      },
      "nix": {
        "command": [
          "nixd"
        ]
      }
    },
    "references": {
      "nvim-config": {
        "path": "~/.dotfiles/nvim",
        "description": "My personal neovim config. Use when asked about neovim or nvim"
      },
      "nix": {
        "path": "~/.dotfiles/nix",
        "description": "My personal nix config. Use when asked about nix"
      },
      "zsh": {
        "path": "~/.dotfiles/zsh",
        "description": "My personal zsh config. Use when asked about zsh"
      }
    },
    "experimental": {
      "policies": [
        { "action": "provider.use", "resource": "*", "effect": "deny" },
        { "action": "provider.use", "resource": "openai", "effect": "allow" },
        { "action": "provider.use", "resource": "opencode", "effect": "allow" }
      ]
    },
    "plugins": [
      "./plugins/pr-context",
      {
        "package": "@plannotator/opencode@0.27.22",
        "options": {
          "workflow": "plan-agent",
          "planningAgents": [
            "planner"
          ]
        }
      }
    ]
  },
  "agents": {
    "chat": {
      "model": "openai/gpt-6-astra#high"
    },
    "planner": {
      "model": "openai/gpt-6-astra#high"
    },
    "explorer": {
      "model": "openai/gpt-5.6-sol#medium"
    },
    "builder": {
      "model": "openai/gpt-5.6-sol#medium"
    },
    "audit-orchestrator": {
      "model": "openai/gpt-6-astra#high"
    },
    "audit-worker": {
      "model": "openai/gpt-5.6-sol#medium"
    }
  },
  "builtin_agents": {
    "general": {
      "hidden": true
    },
    "build": {
      "hidden": true
    },
    "plan": {
      "hidden": true
    }
  },
  "commands": {},
  "skills": [
    "find-docs",
    "find-skills",
    "ghgrab-fetch",
    "manual-test-plan",
    "plannotator-annotate",
    "plannotator-compound",
    "plannotator-last",
    "plannotator-review",
    "plannotator-setup-goal",
    "plannotator-visual-explainer",
    "playwright-cli",
    "simple-coding",
    "test-planning"
  ]
}
