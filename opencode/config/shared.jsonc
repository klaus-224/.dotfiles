{
  "settings": {
    "shell": "/bin/zsh",
    "formatter": true,
    "snapshots": false,
    "update": "disable",
    "plugins": [
      "./plugins/rtk"
    ]
  },
  "agents": {
    "chat": {
      "description": "Chat and collaboration agent.",
      "mode": "primary",
      "steps": 3,
      "system": "{file:agents/chat.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "skill", "resource": "ghgrab-fetch", "effect": "allow" },
        { "action": "skill", "resource": "simple-coding", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" }
      ]
    },
    "planner": {
      "description": "Produces evidence-backed implementation plans and submits them for human approval before code changes begin.",
      "mode": "primary",
      "system": "{file:agents/planner.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "pr_context_get", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "plannotator-annotate", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "submit_plan", "resource": "*", "effect": "allow" }
      ]
    },
    "explorer": {
      "mode": "subagent",
      "system": "{file:agents/explorer.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "skill", "resource": "ghgrab-fetch", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "ghgrab agent tree *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ],
      "description": "Read-only repository and documentation research for the caller."
    },
    "builder": {
      "system": "{file:agents/builder.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "skill", "resource": "ghgrab-fetch", "effect": "allow" },
        { "action": "skill", "resource": "plannotator-review", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git show*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git rev-parse*", "effect": "allow" },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        { "action": "shell", "resource": "rtk git add *", "effect": "allow" },
        { "action": "shell", "resource": "git commit *", "effect": "allow" },
        { "action": "shell", "resource": "rtk git commit *", "effect": "allow" },
        { "action": "shell", "resource": "git add -A*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git add -A*", "effect": "deny" },
        { "action": "shell", "resource": "git add --all*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git add --all*", "effect": "deny" },
        { "action": "shell", "resource": "git add .*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git add .*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*--amend*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git commit*--amend*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*--no-verify*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git commit*--no-verify*", "effect": "deny" },
        { "action": "shell", "resource": "just*", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 *", "effect": "allow" },
        { "action": "shell", "resource": "plannotator review *", "effect": "allow" }
      ],
      "mode": "primary",
      "description": "Implements the human-approved plan and reviews its changes."
    },
    "audit-orchestrator": {
      "description": "Coordinates approved configuration audits in isolated worktrees.",
      "mode": "primary",
      "system": "{file:agents/audit-orchestrator.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "skill", "resource": "ghgrab-fetch", "effect": "allow" },
        { "action": "skill", "resource": "simple-coding", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "audit-worker", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "~/.dotfiles/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/code/dotfiles-audit", "effect": "allow" },
        { "action": "external_directory", "resource": "~/code/dotfiles-audit/**", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "mkdir", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git worktree list*", "effect": "allow" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git * commit*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git push*", "effect": "deny" },
        { "action": "shell", "resource": "git * push*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * push*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git reset*", "effect": "deny" },
        { "action": "shell", "resource": "git * reset*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * reset*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git * clean*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * clean*", "effect": "deny" }
      ]
    },
    "audit-worker": {
      "description": "Implements only assigned audit checkpoints without further delegation.",
      "mode": "subagent",
      "system": "{file:agents/audit-worker.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "skill", "resource": "ghgrab-fetch", "effect": "allow" },
        { "action": "skill", "resource": "simple-coding", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "mkdir", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git * commit*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * commit*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git push*", "effect": "deny" },
        { "action": "shell", "resource": "git * push*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * push*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git reset*", "effect": "deny" },
        { "action": "shell", "resource": "git * reset*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * reset*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git * clean*", "effect": "deny" },
        { "action": "shell", "resource": "rtk git * clean*", "effect": "deny" },
        { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" },
        { "action": "shell", "resource": "plannotator review --commit *", "effect": "allow" },
        { "action": "shell", "resource": "plannotator review --branch *", "effect": "allow" }
      ]
    },
    "ticket-review": {
      "description": "Retrieve Jira intent and coordinate PR review followed by manual test planning.",
      "mode": "primary",
      "system": "{file:agents/ticket-review.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "pr-review", "effect": "allow" },
        { "action": "subagent", "resource": "test-planner", "effect": "allow" },
        { "action": "atlassian_getAccessibleAtlassianResources", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssue", "resource": "*", "effect": "allow" },
        { "action": "atlassian_listJiraIssueComments", "resource": "*", "effect": "allow" },
        { "action": "atlassian_listJiraIssueRemoteIssueLinks", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssueRemoteIssueLinks", "resource": "*", "effect": "allow" },
        { "action": "atlassian_searchJiraIssuesUsingJql", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "allow" }
      ]
    },
    "pr-review": {
      "description": "Inspect linked PR implementations and return evidence-backed manual test scenarios.",
      "mode": "subagent",
      "system": "{file:agents/pr-review.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "gh repo view --json nameWithOwner,url", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh repo view --json nameWithOwner,url", "effect": "allow" },
        { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh pr list *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh pr view *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh pr diff *", "effect": "allow" },
        { "action": "shell", "resource": "gh api --method GET repos/*/pulls/*/files*", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh api --method GET repos/*/pulls/*/files*", "effect": "allow" },
        { "action": "shell", "resource": "gh api --method GET repos/*/contents/*", "effect": "allow" },
        { "action": "shell", "resource": "rtk gh api --method GET repos/*/contents/*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse HEAD", "effect": "allow" },
        { "action": "shell", "resource": "rtk git rev-parse HEAD", "effect": "allow" },
        { "action": "shell", "resource": "git status --short", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status --short", "effect": "allow" },
        { "action": "shell", "resource": "* --output*", "effect": "deny" },
        { "action": "shell", "resource": "* --web*", "effect": "deny" },
        { "action": "shell", "resource": "* --template*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "test-planner": {
      "description": "Turn Jira requirements and completed PR findings into manual tests for the user.",
      "mode": "subagent",
      "system": "{file:agents/test-planner.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "manual-test-plan", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "submit_plan", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "playwright-user": {
      "description": "Plan and execute browser-based verification with Playwright CLI.",
      "mode": "primary",
      "system": "{file:agents/playwright-user.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" },
        { "action": "skill", "resource": "playwright-cli", "effect": "allow" },
        { "action": "skill", "resource": "manual-test-plan", "effect": "allow" },
        { "action": "subagent", "resource": "pr-review", "effect": "allow" }
      ]
    },
    "pw-test-writer": {
      "description": "Write and maintain Playwright tests, fixtures, and page objects.",
      "mode": "primary",
      "system": "{file:agents/pw-test-writer.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "find-docs", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
        { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "skill", "resource": "playwright-cli", "effect": "allow" }
      ]
    },
    "Jira": {
      "description": "Read Jira tickets and linked PRs, and create bugs through a Plannotator form.",
      "mode": "primary",
      "system": "{file:agents/jira-operator.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getAccessibleAtlassianResources", "resource": "*", "effect": "allow" },
        { "action": "atlassian_searchJiraIssuesUsingJql", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssue", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getVisibleJiraProjects", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraProjectIssueTypesMetadata", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssueTypeMetaWithFields", "resource": "*", "effect": "allow" },
        { "action": "atlassian_createJiraIssue", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssueDevelopmentInfo", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "work/jira-bugs/**", "effect": "allow" },
        { "action": "read", "resource": "**/work/jira-bugs/**", "effect": "allow" },
        { "action": "edit", "resource": "work/jira-bugs/**", "effect": "allow" },
        { "action": "edit", "resource": "**/work/jira-bugs/**", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "mkdir -p work/jira-bugs/*", "effect": "allow" },
        { "action": "shell", "resource": "plannotator setup-goal interview work/jira-bugs/*/interview.json --json", "effect": "allow" },
        { "action": "shell", "resource": "plannotator annotate work/jira-bugs/*/bug.md --gate --json", "effect": "allow" },
        { "action": "shell", "resource": "gh pr list *", "effect": "ask" },
        { "action": "shell", "resource": "rtk gh pr list *", "effect": "ask" },
        { "action": "shell", "resource": "gh pr view *", "effect": "ask" },
        { "action": "shell", "resource": "rtk gh pr view *", "effect": "ask" },
        { "action": "shell", "resource": "gh pr diff *", "effect": "ask" },
        { "action": "shell", "resource": "rtk gh pr diff *", "effect": "ask" },
        { "action": "execute", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
