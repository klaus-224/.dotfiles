# Configuration for Ghostty https://ghostty.org/docs
custom-shader = shaders/cursor_tail.glsl

theme = Vague
background = black
font-family = Hack Nerd Font Mono
# font-family = Iosevka Term
font-thicken = true
font-size = 16

cursor-opacity = 1
bold-is-bright = true
background-opacity = 0.6
selection-background = "#0a385c"

window-decoration = none
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-vsync = true

shell-integration = zsh

mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true

macos-option-as-alt = true

bell-features = border
desktop-notifications = false

macos-titlebar-style = hidden

# unbind digit hotkeys
keybind = ctrl+0=unbind 
keybind = ctrl+1=unbind                     
keybind = ctrl+2=unbind                     
keybind = ctrl+3=unbind                     
keybind = ctrl+4=unbind                     
keybind = ctrl+5=unbind                     

background-blur-radius = 10
