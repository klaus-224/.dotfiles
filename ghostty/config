# Configuration for Ghostty https://ghostty.org/docs
# Look up any option with: ghostty +explain-config <option>

# ---- Appearance ----
theme = Vague
# background = #09090a
custom-shader = shaders/cursor_tail.glsl

font-family = Iosevka Term
font-thicken = true
font-size = 16
bold-is-bright = true

cursor-color = #f8ce9d
cursor-opacity = 1

background-opacity = 0.60
background-blur = 30
background-opacity-cells = true

selection-background = #0a385c

# ---- Window ----
window-padding-x = 5
window-padding-y = 5
window-padding-color = extend
window-padding-balance = equal
window-vsync = true
window-decoration = true
fullscreen = false
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
macos-window-shadow = false

# ---- Behaviour ----
shell-integration = zsh
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
macos-option-as-alt = true
bell-features = border
desktop-notifications = false

# ---- Keybinds: Cmd+<key> sends the tmux prefix (C-a, \x01) + <key> ----
# Windows (by character and by physical key, so both layouts work)
keybind = super+5=text:\x01\x25
keybind = super+7=text:\x01\x37
keybind = super+8=text:\x01\x38
keybind = super+9=text:\x01\x39
keybind = super+digit_5=text:\x01\x25
keybind = super+digit_7=text:\x01\x37
keybind = super+digit_8=text:\x01\x38
keybind = super+digit_9=text:\x01\x39

# Panes
keybind = super+k=text:\x01\x6b
keybind = super+l=text:\x01\x6c
keybind = super+z=text:\x01\x7a
keybind = super+x=text:\x01\x78
keybind = super+\=text:\x01\x7C
keybind = super+.=text:\x01\x3E
keybind = super+,=text:\x01\x3C

# Sessions
keybind = super+[=text:\x01\x5B
keybind = super+]=text:\x01\x5D

# Tools and popups
keybind = super+b=text:\x01\x42
keybind = super+c=text:\x01\x43
keybind = super+d=text:\x01\x44
keybind = super+e=text:\x01\x65
keybind = super+g=text:\x01\x47
keybind = super+m=text:\x01\x6d
keybind = super+n=text:\x01\x4e
keybind = super+o=text:\x01\x4f
keybind = super+s=text:\x01\x53
keybind = super+t=text:\x01\x54
keybind = super+w=text:\x01\x77
keybind = super+shift+n=text:\x01\x6e
keybind = super+shift+o=text:\x01\x6f
