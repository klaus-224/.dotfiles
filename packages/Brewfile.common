brew "tmux"
brew "neovim"
brew "starship"
brew "glow" # render markdown

## CLI TOOLS ##
# vsc
brew "git"
brew "gh"
brew "git-delta"

brew "just" # like make but simpler

# file listing
brew "broot"
brew "eza"
brew "tree"
brew "croc" # send files
brew "ttyd" # share terminal over web

# file search
brew "fd"

# text search
brew "ripgrep"

# text viewing
brew "bat"

# fuzzy finding
brew "fzf"
brew "grex"

# json/yaml/csv
brew "jsongrep" # like jq but easier to use
brew "dasel"

# monitoring
brew "bottom"

# tuis
brew "lazygit"
brew "harlequin"

# gettext: https://formulae.brew.sh/formula/gettext
brew "gettext"

# misc
brew "flawz" # https://github.com/orhun/flawz

## END CLI TOOLS ##

