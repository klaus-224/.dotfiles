#!/bin/bash

set -eu

LUA=/opt/homebrew/bin/lua
if [[ -z "${CONFIG_DIR:-}" ]]; then
  CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"
fi
export CONFIG_DIR

if [[ ! -x "$LUA" ]]; then
  printf 'sketchybar: Homebrew Lua is missing at %s; rebuild the nix-darwin configuration first\n' "$LUA" >&2
  exit 1
fi

exec "$LUA" "$CONFIG_DIR/init.lua"
