#!/bin/bash

# Focused window edge in the tmux popup border colour (`@c_active` in
# tmux/.tmux.conf, Vague blue #6E94B2), as SketchyBar's island borders.
# Unfocused windows get none.
# Set active_color=0x00000000 to hide borders entirely.
options=(
  style=rounded
  width=2
  hidpi=on
  active_color=0xff6e94b2
  inactive_color=0x00000000
)

borders "${options[@]}"
