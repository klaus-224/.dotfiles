#!/bin/sh
# Noninteractive counterpart of the former ctx alias. Never install implicitly.
if ! command -v ctx7 >/dev/null 2>&1; then
    printf '%s\n' 'ctx: ctx7 is not on PATH. Optional manual installation: npm install -g ctx7' 'See docs/config-audit.md for dependency and documentation lookup guidance.' >&2
    exit 127
fi
exec ctx7 "$@"
