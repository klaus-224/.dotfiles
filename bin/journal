#!/usr/bin/env zsh
set -euo pipefail

# --------------------------------------------------
# journal - Daily development journal with AI-assisted
#           carry-forward planning from yesterday.
# --------------------------------------------------

function _journal_dir() {
	echo "${JOURNAL_LISTS_DIR:-$HOME/code/dev-journal}"
}

function _date() {
	date +%m-%d-%Y
}

function _date_days_ago() {
	local days="$1"
	date -v-"${days}"d +%m-%d-%Y 2>/dev/null || date -d "${days} days ago" +%m-%d-%Y 2>/dev/null
}

function _file_for_date() {
	local day="$1"
	echo "$(_journal_dir)/${day}.md"
}

function _journal_file() {
	_file_for_date "$(_date)"
}

function _legacy_file() {
	echo "$(_journal_dir)/journal.md"
}

function _ensure_journal_dir() {
	mkdir -p "$(_journal_dir)"
}

function _link_legacy() {
	local journal_file="$1"
	local legacy_file
	legacy_file="$(_legacy_file)"

	ln -sfn "$(basename "$journal_file")" "$legacy_file"
}

function _bootstrap_file() {
	local file="$1"

	if [[ -f "$file" ]]; then
		return 0
	fi

	cat >"$file" <<EOT
Dev Journal
Date: $(_date)
---

### Yesterday
**Accomplished**

**Today's Goal:**

### Worked On
- [ ]

### Next Tasks
- [ ]

### Notes:
- 
EOT
}

function _archive_legacy_internal() {
	local journal_file legacy_file archive_target
	journal_file="$(_journal_file)"
	legacy_file="$(_legacy_file)"
	archive_target="$journal_file"

	_ensure_journal_dir

	if [[ -L "$legacy_file" ]]; then
		_link_legacy "$journal_file"
		return 0
	fi

	if [[ ! -f "$legacy_file" ]]; then
		return 0
	fi

	if [[ -e "$archive_target" ]]; then
		archive_target="$(_journal_dir)/$(_date)-$(date +%H%M%S).md"
	fi

	mv "$legacy_file" "$archive_target"
	echo "Archived: $legacy_file -> $archive_target"

	_link_legacy "$journal_file"
}

function _archive_legacy() {
	local legacy_file
	legacy_file="$(_legacy_file)"

	if [[ ! -f "$legacy_file" && ! -L "$legacy_file" ]]; then
		echo "No journal.md found in $(_journal_dir)"
		return 0
	fi

	_archive_legacy_internal
}

function _previous_journal_file() {
	local i day file
	for i in {1..14}; do
		day="$(_date_days_ago "$i")"
		file="$(_file_for_date "$day")"
		if [[ -f "$file" ]]; then
			echo "$file"
			return 0
		fi
	done

	return 1
}

function _run_agent_prompt() {
	local prompt="$1"
	local agent_cmd=""

	if [[ -n "${JOURNAL_AGENT_CMD:-}" ]]; then
		agent_cmd="$JOURNAL_AGENT_CMD"
	else
		local candidates=(opencode copilot codex)
		local cmd
		for cmd in "${candidates[@]}"; do
			if command -v "$cmd" >/dev/null 2>&1; then
				agent_cmd="$cmd"
				if [[ "$cmd" == "opencode" ]]; then
					agent_cmd="opencode run"
				fi
				break
			fi
		done
	fi

	if [[ -z "$agent_cmd" ]]; then
		echo "No agent CLI found. Set JOURNAL_AGENT_CMD or install one of: opencode, copilot, codex" >&2
		return 1
	fi

	echo "Using agent: $agent_cmd" >&2

	local -a agent_parts
	agent_parts=(${(z)agent_cmd})
	agent_parts=(${(Q)agent_parts})
	"${agent_parts[@]}" "$prompt"
}

function _build_sync_prompt() {
	local previous_file="$1"
	local previous_content
	previous_content="$(<"$previous_file")"

	if [[ -n "${JOURNAL_SYNC_PROMPT:-}" ]]; then
		printf "%s\n\nYesterday's journal:\n%s\n" "$JOURNAL_SYNC_PROMPT" "$previous_content"
		return 0
	fi

	cat <<EOT
You are creating today's development journal from yesterday's journal.

Yesterday's journal path: $previous_file

Yesterday's journal:
---BEGIN JOURNAL---
$previous_content
---END JOURNAL---

Return ONLY this format:

ACCOMPLISHED:
<1-2 short lines summarizing what was completed yesterday>

TODAYS_TASKS:
- [ ] <short task for today>
- [ ] <short task for today>

Rules:
- The ACCOMPLISHED section must be 1-2 lines.
- Every TODAYS_TASKS line must start exactly with "- [ ] ".
- Do not include markdown headings, commentary, or code fences.
EOT
}

function _set_marker_block() {
	local file="$1" marker="$2" stop_regex="$3" content="$4"
	local tmp content_file
	tmp="$(mktemp -t journal-set.XXXXXX)"
	content_file="$(mktemp -t journal-content.XXXXXX)"
	printf "%s" "$content" >"$content_file"

	if ! awk -v marker="$marker" -v stop="$stop_regex" -v content_file="$content_file" '
		BEGIN {
			in_block = 0
			found = 0
			printed = 0
			content = ""
			while ((getline line < content_file) > 0) content = content line "\n"
			close(content_file)
		}
		$0 == marker {
			print
			if (content != "") {
				printf "%s", content
				if (substr(content, length(content), 1) != "\n") print ""
			}
			in_block = 1
			found = 1
			next
		}
		in_block && $0 ~ stop { in_block = 0 }
		!in_block { print }
		END {
			if (!found) {
				print ""
				print marker
				if (content != "") {
					printf "%s", content
					if (substr(content, length(content), 1) != "\n") print ""
				}
			}
		}
	' "$file" >"$tmp"; then
		rm -f "$content_file" "$tmp"
		return 1
	fi

	rm -f "$content_file"
	mv "$tmp" "$file"
}

function _sync() {
	local journal_file previous_file prompt output tmp_output
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	if ! previous_file="$(_previous_journal_file)"; then
		echo "No previous journal file found (looked back 14 days)." >&2
		return 1
	fi

	prompt="$(_build_sync_prompt "$previous_file")"
	tmp_output="$(mktemp -t journal-agent-output.XXXXXX)" || {
		echo "Unable to create temporary output file." >&2
		return 1
	}

	if ! _run_agent_prompt "$prompt" >"$tmp_output"; then
		rm -f "$tmp_output"
		echo "Agent query failed. Set JOURNAL_AGENT_CMD or JOURNAL_SYNC_PROMPT to customize." >&2
		return 1
	fi

	output="$(<"$tmp_output")"
	rm -f "$tmp_output"

	if [[ -z "$output" ]]; then
		echo "Agent returned empty output." >&2
		return 1
	fi

	local line section="" accomplished="" tasks=""
	while IFS= read -r line; do
		line="${line%$'\r'}"
		case "$line" in
		ACCOMPLISHED:*)
			section="accomplished"
			continue
			;;
		TODAYS_TASKS:* | TODAY_TASKS:*)
			section="tasks"
			continue
			;;
		esac

		[[ -z "$line" ]] && continue
		[[ "$line" == '```'* ]] && continue

		case "$section" in
		accomplished)
			accomplished+="${line}"$'\n'
			;;
		tasks)
			if [[ "$line" == "- [ ] "* ]]; then
				tasks+="${line}"$'\n'
			elif [[ "$line" == "- "* ]]; then
				tasks+="- [ ] ${line#- }"$'\n'
			fi
			;;
		esac
	done <<<"$output"

	if [[ -z "$accomplished" && -z "$tasks" ]]; then
		echo "Agent output did not include ACCOMPLISHED or TODAYS_TASKS content." >&2
		return 1
	fi

	if [[ -n "$accomplished" ]]; then
		_set_marker_block "$journal_file" "**Accomplished**" "^[*][*]Today's Goal:[*][*]$|^### " "${accomplished}"$'\n'
	fi

	if [[ -n "$tasks" ]]; then
		_set_marker_block "$journal_file" "**Today's Goal:**" "^### " "${tasks}"$'\n'
	fi

	echo "Synced: $journal_file"
	echo "Source: $previous_file"
}

function _section_last_content_line() {
	local file="$1" heading="$2"

	awk -v heading="$heading" '
		$0 == heading {
			in_section = 1
			found = 1
			last = NR
			next
		}
		in_section && /^### / {
			print last
			printed = 1
			exit
		}
		in_section && $0 !~ /^[[:space:]]*$/ { last = NR }
		END {
			if (!printed) {
				if (found) print last
				else print 0
			}
		}
	' "$file"
}

function _open_file() {
	local file="$1"
	shift

	if ! command -v nvim >/dev/null 2>&1; then
		echo "nvim is required." >&2
		return 1
	fi

	nvim "$@" "$file"
}

function _open_journal() {
	local journal_file
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	_open_file "$journal_file"
}

function _add() {
	local journal_file line line_text
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	line="$(_section_last_content_line "$journal_file" "### Worked On")"
	if [[ "$line" -eq 0 ]]; then
		printf "\n### Worked On\n- [ ]\n" >>"$journal_file"
		line="$(_section_last_content_line "$journal_file" "### Worked On")"
	fi

	line_text="$(awk -v line="$line" 'NR == line { print; exit }' "$journal_file")"
	if [[ "$line_text" == "- [ ]" || "$line_text" == "- [ ] " ]]; then
		_open_file "$journal_file" "+${line}" "+normal! A "
	else
		_open_file "$journal_file" "+${line}" "+normal! o- [ ] "
	fi
}

function _yesterday() {
	local previous_file
	if ! previous_file="$(_previous_journal_file)"; then
		echo "No previous journal file found (looked back 14 days)."
		return 1
	fi

	_open_file "$previous_file"
}

function _fzf_files() {
	local selected

	if ! command -v fzf >/dev/null 2>&1; then
		echo "fzf is required. Install with: brew install fzf" >&2
		return 1
	fi

	_ensure_journal_dir

	selected=$(find "$(_journal_dir)" -maxdepth 1 \( -type f -o -type l \) | sort |
		fzf --height=70% --layout=reverse --prompt='journal> ' \
			--preview 'bat --color=always -n {} 2>/dev/null || sed -n "1,200p" {}')

	[[ -z "$selected" ]] && return 0
	_open_file "$selected"
}

function journal() {
	local cmd="${1:-open}"

	case "$cmd" in
	open)
		_open_journal
		;;
	add)
		_add
		;;
	sync)
		_sync
		;;
	yesterday)
		_yesterday
		;;
	archive)
		_archive_legacy
		;;
	path)
		_journal_file
		;;
	files | list | fzf)
		_fzf_files
		;;
	help | -h | --help)
		cat <<'EOT'
Usage: journal [command]

Commands:
  open        Open today's journal in nvim (default)
  add         Open today's journal at the bottom of Worked On
  sync        Summarize yesterday and create today's goals with an AI agent
  yesterday   Open the most recent previous journal file
  archive     Archive legacy journal.md to a date-based filename
  path        Print today's journal file path
  files       Browse all files in the journal dir with fzf and open selection

Environment:
  JOURNAL_LISTS_DIR    Override journal directory (default: ~/code/dev-journal)
  JOURNAL_AGENT_CMD    Agent CLI for sync (default: auto-detect opencode/copilot/codex)
  JOURNAL_SYNC_PROMPT  Override the prompt sent to the agent for sync
EOT
		;;
	*)
		echo "Unknown command: $cmd" >&2
		echo "Run: journal help" >&2
		return 1
		;;
	esac
}

journal "$@"
