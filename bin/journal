#!/usr/bin/env zsh
set -euo pipefail

typeset -r JIRA_SYNC_AGENT_CMD="opencode run --agent=jira-operator"
typeset -r JOURNAL_SYNC_AGENT_CMD="opencode run --agent=build"

# --------------------------------------------------
# journal - Daily development journal with AI-assisted
#           Jira sync and carry-forward planning.
# --------------------------------------------------

function _journal_dir() {
	echo "$HOME/code/dev-journal"
}

function _date() {
	date +%m-%d-%Y
}

function _date_days_ago() {
	local days="$1"
	date -v-"${days}"d +%m-%d-%Y 2>/dev/null || date -d "${days} days ago" +%m-%d-%Y 2>/dev/null
}

function _file_for_date() {
	local day="$1"
	echo "$(_journal_dir)/${day}.md"
}

function _journal_file() {
	_file_for_date "$(_date)"
}

function _legacy_file() {
	echo "$(_journal_dir)/journal.md"
}

function _ensure_journal_dir() {
	mkdir -p "$(_journal_dir)"
}

function _link_legacy() {
	local journal_file="$1"
	local legacy_file
	legacy_file="$(_legacy_file)"

	ln -sfn "$(basename "$journal_file")" "$legacy_file"
}

function _bootstrap_file() {
	local file="$1"

	if [[ -f "$file" ]]; then
		return 0
	fi

	cat >"$file" <<EOT
Dev Journal
Date: $(_date)
---

### Yesterday
**Accomplished**

**Incomplete / Carried Forward**

### Today's Goal

#### Jira Tickets - Assigned to me

#### Jira Tickets - Assigned to Other

#### Jira Tickets - Unassigned

#### Other Todos

### Worked On
- [ ]

### Notes
- 
EOT
}

function _archive_legacy_internal() {
	local journal_file legacy_file archive_target
	journal_file="$(_journal_file)"
	legacy_file="$(_legacy_file)"
	archive_target="$journal_file"

	_ensure_journal_dir

	if [[ -L "$legacy_file" ]]; then
		_link_legacy "$journal_file"
		return 0
	fi

	if [[ ! -f "$legacy_file" ]]; then
		return 0
	fi

	if [[ -e "$archive_target" ]]; then
		archive_target="$(_journal_dir)/$(_date)-$(date +%H%M%S).md"
	fi

	mv "$legacy_file" "$archive_target"
	echo "Archived: $legacy_file -> $archive_target"

	_link_legacy "$journal_file"
}

function _archive_legacy() {
	local legacy_file
	legacy_file="$(_legacy_file)"

	if [[ ! -f "$legacy_file" && ! -L "$legacy_file" ]]; then
		echo "No journal.md found in $(_journal_dir)"
		return 0
	fi

	_archive_legacy_internal
}

function _previous_journal_file() {
	local i day file
	for i in {1..14}; do
		day="$(_date_days_ago "$i")"
		file="$(_file_for_date "$day")"
		if [[ -f "$file" ]]; then
			echo "$file"
			return 0
		fi
	done

	return 1
}

function _run_agent_prompt() {
	local agent_cmd="$1" prompt="$2"

	echo "Using agent: $agent_cmd" >&2

	local -a agent_parts
	agent_parts=(${(z)agent_cmd})
	agent_parts=(${(Q)agent_parts})
	"${agent_parts[@]}" "$prompt"
}

function _build_journal_prompt() {
	local previous_file="$1"
	local previous_content
	previous_content="$(<"$previous_file")"

cat <<EOT
You are summarizing yesterday's development journal.

Yesterday's journal path: $previous_file

Yesterday's journal:
---BEGIN JOURNAL---
$previous_content
---END JOURNAL---

Return ONLY this format:

ACCOMPLISHED:
<1-2 short lines summarizing completed work>

Rules:
- ACCOMPLISHED must summarize only work marked complete with "- [x]" in yesterday's journal.
- Do not include markdown headings, commentary, or code fences.
EOT
}

function _build_jira_prompt() {
	cat <<'EOT'
Fetch all Jira tickets in QC using this JQL Query:
project = ION AND status = "In QC" ORDER BY workItem ASC, updated DESC, status DESC, summary ASC, created DESC

Return ONLY this format:

JIRA_TICKETS_ASSIGNED_TO_ME:
- [ ] KEY-123 Short title [link](url)

JIRA_TICKETS_ASSIGNED_TO_OTHER:
- [ ] KEY-456 Short title [link](url)

JIRA_TICKETS_UNASSIGNED:
- [ ] KEY-123 Short title [link](url)

Rules:
- Include every ticket returned by the QC query exactly once.
- Classify tickets by assignee: current user, another user, or no assignee.
- Preserve the query result order within each assignee section.
- Jira output must contain only the Jira key, short title, and ticket link under the appropriate section.
- Do not fetch comments, descriptions, changelogs, worklogs, pull requests, or unrelated fields.
- Every ticket line must start exactly with "- [ ] " and contain a Jira key.
- Do not include duplicate Jira keys.
- Do not include markdown headings, commentary, or code fences.
EOT
}

function _skip_agent() {
	local name="$1" value
	value="${(P)1:-1}"
	if [[ "$value" != 0 && "$value" != 1 ]]; then
		echo "$name must be 0 or 1 (got: $value)" >&2
		return 2
	fi
	[[ "$value" == 1 ]]
}

function _todo_identity() {
	local line="$1" text key
	key="$(printf '%s\n' "$line" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -1 || true)"
	if [[ -n "$key" ]]; then
		printf 'jira:%s' "${key:u}"
		return
	fi

	text="${line#- [ ] }"
	text="${text#- [x] }"
	text="${text#- [X] }"
	printf 'text:%s' "$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
}

function _todo_is_checked() {
	[[ "$1" == '- [x] '* || "$1" == '- [X] '* ]]
}

function _section_todos() {
	local file="$1" heading="$2"
	awk -v heading="$heading" '
		$0 == heading { in_section = 1; next }
		in_section && /^### / { exit }
		in_section && /^#### / { exit }
		in_section && /^- \[[ xX]\] / { print }
	' "$file"
}

function _merge_todos() {
	local existing="$1" additions="$2" line identity index
	local -a lines=()
	local -A positions=() checked=()

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		[[ -n "${positions[$identity]:-}" ]] && continue
		lines+=("$line")
		positions[$identity]=${#lines[@]}
		if _todo_is_checked "$line"; then checked[$identity]=1; fi
	done <<< "$existing"

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		if [[ -n "${positions[$identity]:-}" ]]; then
			index=${positions[$identity]}
			if _todo_is_checked "$line" && [[ -z "${checked[$identity]:-}" ]]; then
				lines[$index]="$line"
				checked[$identity]=1
			fi
			continue
		fi
		lines+=("$line")
		positions[$identity]=${#lines[@]}
		if _todo_is_checked "$line"; then checked[$identity]=1; fi
	done <<< "$additions"

	printf '%s\n' "${lines[@]}"
}

function _merge_jira_todos() {
	local existing="$1" previous="$2" additions="$3" line identity
	local -a lines=()
	local -A positions=() checked=()

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		[[ "$identity" == jira:* ]] || continue
		if _todo_is_checked "$line"; then checked[$identity]=1; fi
	done <<< "$existing"$'\n'"$previous"

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		[[ "$identity" == jira:* ]] || continue
		[[ -n "${positions[$identity]:-}" ]] && continue
		if [[ -n "${checked[$identity]:-}" ]]; then
			line="- [x] ${line#- [ ] }"
			line="- [x] ${line#- [x] }"
			line="- [x] ${line#- [X] }"
		fi
		lines+=("$line")
		positions[$identity]=${#lines[@]}
	done <<< "$additions"

	printf '%s\n' "${lines[@]}"
}

function _remove_duplicate_jira_todos() {
	local todos="$1" jira_todos="$2" line identity
	local -A jira_keys=()

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		[[ "$identity" == jira:* ]] && jira_keys[$identity]=1
	done <<< "$jira_todos"

	while IFS= read -r line; do
		[[ "$line" == '- ['* ]] || continue
		identity="$(_todo_identity "$line")"
		[[ -n "${jira_keys[$identity]:-}" ]] && continue
		printf '%s\n' "$line"
	done <<< "$todos"
}

function _migrate_jira_heading() {
	local file="$1" old_heading="$2" new_heading="$3" tmp

	if ! grep -Fqx "$old_heading" "$file" || grep -Fqx "$new_heading" "$file"; then
		return 0
	fi

	tmp="$(mktemp -t journal-heading.XXXXXX)"
	awk -v old_heading="$old_heading" -v new_heading="$new_heading" \
		'$0 == old_heading { print new_heading; next } { print }' "$file" >"$tmp"
	mv "$tmp" "$file"
}

function _set_marker_block() {
	local file="$1" marker="$2" stop_regex="$3" content="$4"
	local tmp content_file
	tmp="$(mktemp -t journal-set.XXXXXX)"
	content_file="$(mktemp -t journal-content.XXXXXX)"
	printf "%s" "$content" >"$content_file"

	if ! awk -v marker="$marker" -v stop="$stop_regex" -v content_file="$content_file" '
		BEGIN {
			in_block = 0
			found = 0
			printed = 0
			content = ""
			while ((getline line < content_file) > 0) content = content line "\n"
			close(content_file)
		}
		$0 == marker {
			print
			if (content != "") {
				printf "%s", content
				if (substr(content, length(content), 1) != "\n") print ""
			}
			in_block = 1
			found = 1
			next
		}
		in_block && $0 ~ stop { in_block = 0 }
		!in_block { print }
		END {
			if (!found) {
				print ""
				print marker
				if (content != "") {
					printf "%s", content
					if (substr(content, length(content), 1) != "\n") print ""
				}
			}
		}
	' "$file" >"$tmp"; then
		rm -f "$content_file" "$tmp"
		return 1
	fi

	rm -f "$content_file"
	mv "$tmp" "$file"
}

function _sync() {
	local journal_file previous_file output="" agent_output
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	if ! previous_file="$(_previous_journal_file)"; then
		echo "No previous journal file found (looked back 14 days)." >&2
		return 1
	fi

	if _skip_agent SKIP_SYNC_AGENT; then
		:
	else
		[[ $? -eq 1 ]] || return 1
		agent_output="$(_run_agent_prompt "$JOURNAL_SYNC_AGENT_CMD" "$(_build_journal_prompt "$previous_file")")" || {
			echo "Journal agent query failed." >&2
			return 1
		}
		output+="$agent_output"$'\n'
	fi

	if _skip_agent SKIP_JIRA_AGENT; then
		:
	else
		[[ $? -eq 1 ]] || return 1
		agent_output="$(_run_agent_prompt "$JIRA_SYNC_AGENT_CMD" "$(_build_jira_prompt)")" || {
			echo "Jira agent query failed." >&2
			return 1
		}
		output+="$agent_output"$'\n'
	fi

	local line section="" accomplished="" jira_assigned_to_me="" jira_assigned_to_other="" jira_unassigned=""
	while IFS= read -r line; do
		line="${line%$'\r'}"
		case "$line" in
		ACCOMPLISHED:*)
			section="accomplished"
			continue
			;;
		JIRA_TICKETS_ASSIGNED_TO_ME: | ASSIGNED_TO_ME:)
			section="jira_assigned_to_me"
			continue
			;;
		JIRA_TICKETS_ASSIGNED_TO_OTHER:)
			section="jira_assigned_to_other"
			continue
			;;
		JIRA_TICKETS_UNASSIGNED:)
			section="jira_unassigned"
			continue
			;;
		esac

		[[ -z "$line" ]] && continue
		[[ "$line" == '```'* ]] && continue

		case "$section" in
		accomplished)
			accomplished+="${line}"$'\n'
			;;
		jira_assigned_to_me | jira_assigned_to_other | jira_unassigned)
			local jira_line=""
			if [[ "$line" == "- [ ] "* ]]; then
				jira_line="$line"
			elif [[ "$line" == "- "* ]]; then
				jira_line="- [ ] ${line#- }"
			fi
			if [[ -n "$jira_line" ]]; then
				case "$section" in
				jira_assigned_to_me) jira_assigned_to_me+="${jira_line}"$'\n' ;;
				jira_assigned_to_other) jira_assigned_to_other+="${jira_line}"$'\n' ;;
				jira_unassigned) jira_unassigned+="${jira_line}"$'\n' ;;
				esac
			fi
			;;
		esac
	done <<<"$output"

	local previous_assigned_to_me previous_assigned_to_other previous_unassigned previous_other
	previous_assigned_to_me="$(_section_todos "$previous_file" "#### Jira Tickets - Assigned to me")"
	if [[ -z "$previous_assigned_to_me" ]]; then
		previous_assigned_to_me="$(_section_todos "$previous_file" "#### Jira Tickets - assigned to me")"
	fi
	previous_assigned_to_me="$(printf '%s\n' "$previous_assigned_to_me" | awk '/^- \[ \] / { print }')"
	previous_assigned_to_other="$(_section_todos "$previous_file" "#### Jira Tickets - Assigned to Other" | awk '/^- \[ \] / { print }')"
	previous_unassigned="$(_section_todos "$previous_file" "#### Jira Tickets - Unassigned" | awk '/^- \[ \] / { print }')"
	previous_other="$(_section_todos "$previous_file" "### Worked On")"
	previous_other+=$'\n'"$(_section_todos "$previous_file" "#### Other Todos")"
	previous_other="$(printf '%s\n' "$previous_other" | awk '/^- \[ \] / { print }')"
	local existing_assigned_to_me existing_assigned_to_other existing_unassigned existing_other
	existing_assigned_to_me="$(_section_todos "$journal_file" "#### Jira Tickets - Assigned to me")"
	if [[ -z "$existing_assigned_to_me" ]]; then
		existing_assigned_to_me="$(_section_todos "$journal_file" "#### Jira Tickets - assigned to me")"
	fi
	existing_assigned_to_other="$(_section_todos "$journal_file" "#### Jira Tickets - Assigned to Other")"
	existing_unassigned="$(_section_todos "$journal_file" "#### Jira Tickets - Unassigned")"
	existing_other="$(_section_todos "$journal_file" "#### Other Todos")"

	local merged_assigned_to_me merged_assigned_to_other merged_unassigned merged_other
	merged_assigned_to_me="$(_merge_jira_todos "$existing_assigned_to_me" "$previous_assigned_to_me" "$jira_assigned_to_me")"
	merged_assigned_to_other="$(_merge_jira_todos "$existing_assigned_to_other" "$previous_assigned_to_other" "$jira_assigned_to_other")"
	merged_unassigned="$(_merge_jira_todos "$existing_unassigned" "$previous_unassigned" "$jira_unassigned")"
	merged_assigned_to_other="$(_remove_duplicate_jira_todos "$merged_assigned_to_other" "$merged_assigned_to_me")"
	merged_unassigned="$(_remove_duplicate_jira_todos "$merged_unassigned" "$merged_assigned_to_me"$'\n'"$merged_assigned_to_other")"
	merged_other="$(_merge_todos "$existing_other" "$previous_other")"
	merged_other="$(_remove_duplicate_jira_todos "$merged_other" "$merged_assigned_to_me"$'\n'"$merged_assigned_to_other"$'\n'"$merged_unassigned")"

	_migrate_jira_heading "$journal_file" "#### Jira Tickets - assigned to me" "#### Jira Tickets - Assigned to me"
	_set_marker_block "$journal_file" "**Accomplished**" "^[*][*]Incomplete / Carried Forward[*][*]$|^### " "${accomplished:-No completed work recorded.}"$'\n'
	_set_marker_block "$journal_file" "#### Jira Tickets - Assigned to me" "^#### |^### " "\n$merged_assigned_to_me"$'\n'
	_set_marker_block "$journal_file" "#### Jira Tickets - Assigned to Other" "^#### |^### " "\n$merged_assigned_to_other"$'\n'
	_set_marker_block "$journal_file" "#### Jira Tickets - Unassigned" "^#### |^### " "\n$merged_unassigned"$'\n'
	_set_marker_block "$journal_file" "#### Other Todos" "^#### |^### " "\n$merged_other"$'\n'

	echo "Synced: $journal_file"
	echo "Source: $previous_file"
	echo "Jira tickets: $(printf '%s\n' "$merged_assigned_to_me" "$merged_assigned_to_other" "$merged_unassigned" | awk '/^- \[ / { count++ } END { print count + 0 }')"
	echo "Carried-forward todos: $(printf '%s\n' "$merged_other" | awk '/^- \[ / { count++ } END { print count + 0 }')"
}

function _section_last_content_line() {
	local file="$1" heading="$2"

	awk -v heading="$heading" '
		$0 == heading {
			in_section = 1
			found = 1
			last = NR
			next
		}
		in_section && /^### / {
			print last
			printed = 1
			exit
		}
		in_section && $0 !~ /^[[:space:]]*$/ { last = NR }
		END {
			if (!printed) {
				if (found) print last
				else print 0
			}
		}
	' "$file"
}

function _open_file() {
	local file="$1"
	shift

	if ! command -v nvim >/dev/null 2>&1; then
		echo "nvim is required." >&2
		return 1
	fi

	nvim "$@" "$file"
}

function _open_journal() {
	local journal_file
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	_open_file "$journal_file"
}

function _add() {
	local journal_file line line_text
	journal_file="$(_journal_file)"

	_ensure_journal_dir
	_archive_legacy_internal
	_bootstrap_file "$journal_file"
	_link_legacy "$journal_file"

	line="$(_section_last_content_line "$journal_file" "### Worked On")"
	if [[ "$line" -eq 0 ]]; then
		printf "\n### Worked On\n- [ ]\n" >>"$journal_file"
		line="$(_section_last_content_line "$journal_file" "### Worked On")"
	fi

	line_text="$(awk -v line="$line" 'NR == line { print; exit }' "$journal_file")"
	if [[ "$line_text" == "- [ ]" || "$line_text" == "- [ ] " ]]; then
		_open_file "$journal_file" "+${line}" "+normal! A "
	else
		_open_file "$journal_file" "+${line}" "+normal! o- [ ] "
	fi
}

function _yesterday() {
	local previous_file
	if ! previous_file="$(_previous_journal_file)"; then
		echo "No previous journal file found (looked back 14 days)."
		return 1
	fi

	_open_file "$previous_file"
}

function _fzf_files() {
	local selected

	if ! command -v fzf >/dev/null 2>&1; then
		echo "fzf is required. Install with: brew install fzf" >&2
		return 1
	fi

	_ensure_journal_dir

	selected=$(find "$(_journal_dir)" -maxdepth 1 \( -type f -o -type l \) | sort |
		fzf --height=70% --layout=reverse --prompt='journal> ' \
			--preview 'bat --color=always -n {} 2>/dev/null || sed -n "1,200p" {}')

	[[ -z "$selected" ]] && return 0
	_open_file "$selected"
}

function journal() {
	local cmd="${1:-open}"

	case "$cmd" in
	open)
		_open_journal
		;;
	add)
		_add
		;;
	sync)
		_sync
		;;
	yesterday)
		_yesterday
		;;
	archive)
		_archive_legacy
		;;
	path)
		_journal_file
		;;
	files | list | fzf)
		_fzf_files
		;;
	help | -h | --help)
		cat <<'EOT'
Usage: journal [command]

Commands:
  open        Open today's journal in nvim (default)
  add         Open today's journal at the bottom of Worked On
  sync        Sync Jira tickets, summarize yesterday, and carry forward todos
  yesterday   Open the most recent previous journal file
  archive     Archive legacy journal.md to a date-based filename
  path        Print today's journal file path
  files       Browse all files in the journal dir with fzf and open selection

Environment:
  SKIP_JIRA_AGENT       Skip Jira sync agent (0 or 1, default: 1)
  SKIP_SYNC_AGENT       Skip journal sync agent (0 or 1, default: 1)
EOT
		;;
	*)
		echo "Unknown command: $cmd" >&2
		echo "Run: journal help" >&2
		return 1
		;;
	esac
}

journal "$@"
