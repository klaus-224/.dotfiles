#!/usr/bin/env zsh
set -euo pipefail

# --------------------------------------------------
# today — Manual-first daily todo list with optional
#          additive Jira sync via any AI agent CLI.
# --------------------------------------------------
function _lists_dir() {
	echo "${TODAY_LISTS_DIR:-$HOME/Documents/lists}"
}

function _date() {
	date +%F
}

function _file_for_date() {
	local day="$1"
	echo "$(_lists_dir)/${day}.md"
}

function _today_file() {
	_file_for_date "$(_date)"
}

function _legacy_file() {
	echo "$(_lists_dir)/today.md"
}

function _ensure_lists_dir() {
	mkdir -p "$(_lists_dir)"
}

function _link_legacy() {
	local today_file="$1"
	local legacy_file
	legacy_file="$(_legacy_file)"

	ln -sfn "$(basename "$today_file")" "$legacy_file"
}

function _bootstrap_file() {
	local file="$1"

	if [[ -f "$file" ]]; then
		return 0
	fi

	cat >"$file" <<EOT
# $(_date) Tasks

## Other Todos

## Jira Tickets - assigned to me

## Jira Tickets - others

EOT
}

function _archive_legacy_internal() {
	local today_file legacy_file archive_target
	today_file="$(_today_file)"
	legacy_file="$(_legacy_file)"
	archive_target="$today_file"

	_ensure_lists_dir

	if [[ -L "$legacy_file" ]]; then
		_link_legacy "$today_file"
		return 0
	fi

	if [[ ! -f "$legacy_file" ]]; then
		return 0
	fi

	if [[ -e "$archive_target" ]]; then
		archive_target="$(_lists_dir)/$(_date)-$(date +%H%M%S).md"
	fi

	mv "$legacy_file" "$archive_target"
	echo "Archived: $legacy_file -> $archive_target"

	_link_legacy "$today_file"
}

function _archive_legacy() {
	local legacy_file
	legacy_file="$(_legacy_file)"

	if [[ ! -f "$legacy_file" && ! -L "$legacy_file" ]]; then
		echo "No today.md found in $(_lists_dir)"
		return 0
	fi

	_archive_legacy_internal
}

function _run_agent_prompt() {
	local prompt="$1"
	local agent_cmd=""

	if [[ -n "${TODAY_AGENT_CMD:-}" ]]; then
		agent_cmd="$TODAY_AGENT_CMD"
	else
		local candidates=(opencode copilot codex)
		for cmd in "${candidates[@]}"; do
			if command -v "$cmd" >/dev/null 2>&1; then
				agent_cmd="$cmd"
				break
			fi
		done
	fi

	if [[ -z "$agent_cmd" ]]; then
		echo "No agent CLI found. Set TODAY_AGENT_CMD or install one of: opencode, copilot, codex" >&2
		return 1
	fi

	echo "Using agent: $agent_cmd" >&2

	eval "$agent_cmd \"\$prompt\""
}

function _jira_sync() {
	local today_file prompt output tmp_output
	today_file="$(_today_file)"

	_ensure_lists_dir
	_archive_legacy_internal
	_bootstrap_file "$today_file"

	# Migrate old ## Jira section to new format
	_migrate_jira_section "$today_file"
  
  default_prompt="Run this JQL only:/n \'assignee = currentUser() AND status = \"In QC\" ORDER BY priority DESC, updated DESC\'\nReturn a markdown todo list split into exactly two sections with these exact markers:\nASSIGNED_TO_ME:\n- [ ] KEY-123 Short title [link](url)\n\nOTHERS:\nUse only Jira key, short title, and ticket link. Do not fetch comments, descriptions, changelog, PRs, worklogs, or full issue fields. Return ONLY the section markers and list items. No commentary."

  prompt="${TODAY_JIRA_PROMPT:-$default_prompt}"

	tmp_output="$(mktemp -t today-agent-output.XXXXXX)" || {
		echo "Unable to create temporary output file." >&2
		return 1
	}

  echo "Running agent prompt"
	if ! _run_agent_prompt "$prompt" >"$tmp_output" 2>&1; then
		rm -f "$tmp_output"
		echo "Agent query failed. Set TODAY_AGENT_CMD or TODAY_JIRA_PROMPT to customize." >&2
		return 1
	fi

	output="$(<"$tmp_output")"
	rm -f "$tmp_output"

	if [[ -z "$output" ]]; then
		echo "Agent returned empty output." >&2
		return 1
	fi

	# Extract existing Jira ticket keys from today's file
	local existing_keys=""
	if [[ -f "$today_file" ]]; then
		existing_keys=$(grep -oE '[A-Z][A-Z0-9]+-[0-9]+' "$today_file" 2>/dev/null || true)
	fi

	# Parse agent output into two lists using section markers
	local mine_tasks="" others_tasks="" current_section=""
	while IFS= read -r line; do
		if [[ "$line" == "ASSIGNED_TO_ME:"* ]]; then
			current_section="mine"
			continue
		elif [[ "$line" == "OTHERS:"* ]]; then
			current_section="others"
			continue
		fi

		[[ -z "$line" ]] && continue
		[[ "$line" != *"- ["* ]] && continue

		# Deduplicate against existing keys
		local key
		key=$(echo "$line" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' 2>/dev/null | head -1 || true)
		if [[ -n "$key" ]] && echo "$existing_keys" | grep -qF "$key" 2>/dev/null; then
			continue
		fi

		case "$current_section" in
		mine)   mine_tasks+="${line}"$'\n' ;;
		others) others_tasks+="${line}"$'\n' ;;
		esac
	done <<<"$output"

	local count=0

	# Append new tasks under each section
	if [[ -n "$mine_tasks" ]]; then
		_append_to_section "$today_file" "## Jira Tickets - assigned to me" "$mine_tasks"
		count=$((count + $(echo -n "$mine_tasks" | grep -c '^- \[' || true)))
	fi

	if [[ -n "$others_tasks" ]]; then
		_append_to_section "$today_file" "## Jira Tickets - others" "$others_tasks"
		count=$((count + $(echo -n "$others_tasks" | grep -c '^- \[' || true)))
	fi

	if [[ $count -eq 0 ]]; then
		echo "No new Jira tasks to add."
		return 0
	fi

	_link_legacy "$today_file"
	echo "Added $count Jira task(s) to: $today_file"
}

# Append $items under the given $section_heading in $file.
# If the heading doesn't exist, create it at the end of the file.
function _append_to_section() {
	local file="$1" heading="$2" items="$3"

	if grep -qF "$heading" "$file" 2>/dev/null; then
		# Find the line number of the heading, then find next ## heading or EOF
		local heading_line next_section_line total_lines
		heading_line=$(grep -n "^${heading}$" "$file" | head -1 | cut -d: -f1)
		total_lines=$(wc -l <"$file")

    if [[ -z $heading_line ]]; then 
      return 1
    fi

		# Find first ^## line after the heading
    next_section_line=$(awk "NR > $heading_line && /^## / { print NR; exit }" "$file" || true)

		if [[ -z "$next_section_line" ]]; then
			# No next section — append at end of file
			printf "%s" "$items" >>"$file"
		else
			# Insert before the next section heading
			local insert_at=$(( next_section_line - 1 ))
			local tmp
			tmp="$(mktemp -t today-insert.XXXXXX)"

      head -n "$insert_at" "$file" > "$tmp"
      printf "%s" "$items" >> "$tmp"
      tail -n +"$(( insert_at + 1 ))" "$file" >> "$tmp"

			mv "$tmp" "$file"
		fi
	else
		# Section doesn't exist — create it at end
		printf "\n%s\n%s" "$heading" "$items" >>"$file"
	fi
}

# One-time migration: rename old ## Jira to ## Jira Tickets - assigned to me
# and add ## Jira Tickets - others below it.
function _migrate_jira_section() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	grep -q '^## Jira$' "$file" 2>/dev/null || return 0

	local tmp
	tmp="$(mktemp -t today-migrate.XXXXXX)"
	awk '
		/^## Jira$/ {
			print "## Jira Tickets - assigned to me"
			next
		}
		{ print }
	' "$file" >"$tmp"

	# Add ## Jira Tickets - others if not present
	if ! grep -q '^## Jira Tickets - others$' "$tmp" 2>/dev/null; then
		printf "\n## Jira Tickets - others\n" >>"$tmp"
	fi

	mv "$tmp" "$file"
	echo "Migrated legacy ## Jira section." >&2
}

function _add() {
	local today_file
	today_file="$(_today_file)"

	_ensure_lists_dir
	_archive_legacy_internal
	_bootstrap_file "$today_file"
	_link_legacy "$today_file"

	_open_file "$today_file" "+normal Go"
}

function _yesterday() {
	local i day file
	for i in {1..14}; do
		day=$(date -v-${i}d +%F 2>/dev/null || date -d "$i days ago" +%F 2>/dev/null)
		file="$(_file_for_date "$day")"
		if [[ -f "$file" ]]; then
			_open_file "$file"
			return 0
		fi
	done

	echo "No previous day's file found (looked back 14 days)."
	return 1
}

function _open_file() {
	local file="$1"
	shift

	if ! command -v nvim >/dev/null 2>&1; then
		echo "nvim is required." >&2
		return 1
	fi

	nvim "$@" "$file"
}

function _open_today() {
	local today_file
	today_file="$(_today_file)"

	_ensure_lists_dir
	_archive_legacy_internal
	_bootstrap_file "$today_file"
	_link_legacy "$today_file"

	_open_file "$today_file"
}

function _fzf_files() {
	local selected

	if ! command -v fzf >/dev/null 2>&1; then
		echo "fzf is required. Install with: brew install fzf" >&2
		return 1
	fi

	_ensure_lists_dir

	selected=$(find "$(_lists_dir)" -maxdepth 1 -type f | sort |
		fzf --height=70% --layout=reverse --prompt='lists> ' \
			--preview 'bat --color=always -n {} 2>/dev/null || sed -n "1,200p" {}')

	[[ -z "$selected" ]] && return 0
	_open_file "$selected"
}

function today() {
	local cmd="${1:-open}"

	case "$cmd" in
	open)
		_open_today
		;;
	add)
		_add
		;;
	sync | jira)
		_jira_sync
		;;
	refresh)
		_jira_sync && _open_today
		;;
	yesterday)
		_yesterday
		;;
	archive)
		_archive_legacy
		;;
	path)
		_today_file
		;;
	files | list | fzf)
		_fzf_files
		;;
	help | -h | --help)
		cat <<'EOT'
Usage: today [command]

Commands:
  open        Open today's list in nvim (default)
  add         Open today's file at the end for quick task entry
  sync        Additively import Jira tasks (never overwrites existing content)
  refresh     Sync Jira tasks, then open today's file
  yesterday   Open the most recent previous day's file
  archive     Archive legacy today.md to a date-based filename
  path        Print today's file path
  files       Browse all files in lists dir with fzf and open selection

Environment:
  TODAY_LISTS_DIR      Override lists directory (default: ~/Documents/lists)
  TODAY_AGENT_CMD      Agent CLI to use for Jira sync (default: auto-detect opencode/copilot/codex)
  TODAY_JIRA_PROMPT    Override the prompt sent to the agent for Jira sync
EOT
		;;
	*)
		echo "Unknown command: $cmd" >&2
		echo "Run: today help" >&2
		return 1
		;;
	esac
}

today "$@"
