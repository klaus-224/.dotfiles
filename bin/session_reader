#!/usr/bin/env python3
"""Extract session transcripts from an agent's SQLite session DB for review."""

import argparse
import json
import sqlite3
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "session_reader" / "config.json"

# Platform-aware preset paths
_darwin = sys.platform == "darwin"

PRESETS = [
    {
        "label": "OpenCode",
        "path": Path.home() / ".local" / "share" / "opencode" / "opencode.db",
    },
    {
        "label": "Cursor",
        "path": (
            Path.home()
            / "Library"
            / "Application Support"
            / "Cursor"
            / "User"
            / "globalStorage"
            / "state.vscdb"
            if _darwin
            else Path.home()
            / ".config"
            / "Cursor"
            / "User"
            / "globalStorage"
            / "state.vscdb"
        ),
    },
    {
        "label": "Windsurf",
        "path": (
            Path.home()
            / "Library"
            / "Application Support"
            / "Windsurf"
            / "User"
            / "globalStorage"
            / "state.vscdb"
            if _darwin
            else Path.home()
            / ".config"
            / "Windsurf"
            / "User"
            / "globalStorage"
            / "state.vscdb"
        ),
    },
]


def run_setup():
    """Interactively prompt the user to select or enter a DB path and save config."""
    print("\nNo session database configured. Select your agent:\n")
    for i, p in enumerate(PRESETS, 1):
        print(f"  {i}) {p['label']:<12} ({p['path']})")
    print(f"  {len(PRESETS) + 1}) Custom path  (enter your own)\n")

    default = 1
    try:
        raw = input(f"Choice [{default}]: ").strip()
        choice = int(raw) if raw else default
    except (ValueError, EOFError):
        choice = default

    if 1 <= choice <= len(PRESETS):
        db_path = PRESETS[choice - 1]["path"]
        agent = PRESETS[choice - 1]["label"].lower()
    elif choice == len(PRESETS) + 1:
        try:
            raw_path = input("Enter full path to database: ").strip()
        except EOFError:
            print("Aborted.", file=sys.stderr)
            sys.exit(1)
        db_path = Path(raw_path).expanduser()
        agent = "custom"
    else:
        print("Invalid choice. Defaulting to OpenCode.", file=sys.stderr)
        db_path = PRESETS[0]["path"]
        agent = "opencode"

    if not db_path.exists():
        print(f"Warning: file not found at {db_path} — saving anyway.", file=sys.stderr)

    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(
        json.dumps({"db_path": str(db_path), "agent": agent}, indent=2)
    )
    print(f"Saved config to {CONFIG_PATH}\n", file=sys.stderr)
    return db_path


def get_db_path():
    if CONFIG_PATH.exists():
        try:
            cfg = json.loads(CONFIG_PATH.read_text())
            return Path(cfg["db_path"])
        except (json.JSONDecodeError, KeyError):
            pass
    return run_setup()


def get_db():
    db_path = get_db_path()
    if not db_path.exists():
        print(json.dumps({"error": f"Database not found at {db_path}"}))
        sys.exit(1)
    conn = sqlite3.connect(str(db_path))
    _ensure_flagged_table(conn)
    return conn


def _ensure_flagged_table(conn):
    conn.execute("""
        CREATE TABLE IF NOT EXISTS flagged_sessions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id TEXT NOT NULL,
            agent_name TEXT NOT NULL,
            blocker_reason TEXT NOT NULL,
            flagged_at TEXT NOT NULL,
            resolved INTEGER DEFAULT 0,
            resolved_at TEXT,
            notes TEXT
        )
    """)
    conn.commit()


def list_sessions(args):
    db = get_db()
    cur = db.execute(
        """SELECT id, title, time_created, time_updated
           FROM session
           WHERE title LIKE ? OR title LIKE ?
           ORDER BY time_created DESC
           LIMIT ?""",
        (f"%{args.search}%", f"%{args.search}%", args.limit),
    )
    rows = [
        {"id": r[0], "title": r[1], "created": r[2], "updated": r[3]}
        for r in cur.fetchall()
    ]
    print(json.dumps(rows, indent=2))


def get_transcript(args):
    db = get_db()
    cur = db.execute(
        """SELECT m.data FROM message m
           WHERE m.session_id = ?
           ORDER BY m.time_created ASC""",
        (args.session_id,),
    )

    messages = []
    for (data_str,) in cur.fetchall():
        try:
            data = json.loads(data_str)
        except json.JSONDecodeError:
            continue

        entry = {
            "role": data.get("role"),
            "agent": data.get("agent"),
            "model": data.get("modelID"),
        }

        # Include finish reason for assistant messages
        if data.get("finish"):
            entry["finish"] = data["finish"]

        messages.append(entry)

    # Now get parts which contain the actual content
    cur = db.execute(
        """SELECT p.message_id, p.data FROM part p
           WHERE p.session_id = ?
           ORDER BY p.time_created ASC""",
        (args.session_id,),
    )

    parts_by_msg = {}
    for msg_id, data_str in cur.fetchall():
        try:
            data = json.loads(data_str)
        except json.JSONDecodeError:
            continue
        parts_by_msg.setdefault(msg_id, []).append(data)

    # Get message IDs in order
    cur = db.execute(
        """SELECT id, data FROM message m
           WHERE m.session_id = ?
           ORDER BY m.time_created ASC""",
        (args.session_id,),
    )

    transcript = []
    for msg_id, data_str in cur.fetchall():
        try:
            data = json.loads(data_str)
        except json.JSONDecodeError:
            continue

        entry = {
            "role": data.get("role"),
            "agent": data.get("agent"),
        }

        parts = parts_by_msg.get(msg_id, [])
        content_parts = []
        for p in parts:
            ptype = p.get("type")
            if ptype == "text":
                content_parts.append({"type": "text", "text": p.get("text", "")[:2000]})
            elif ptype == "tool":
                state = p.get("state", {})
                content_parts.append(
                    {
                        "type": "tool-call",
                        "tool": p.get("tool", "?"),
                        "status": state.get("status", "?"),
                        "args_preview": str(state.get("input", {}))[:200],
                        "result_preview": str(state.get("output", ""))[:300],
                    }
                )
            elif ptype == "reasoning":
                content_parts.append(
                    {"type": "reasoning", "text": p.get("text", "")[:2000]}
                )

        entry["parts"] = content_parts
        transcript.append(entry)

    # Truncate if too long
    output = json.dumps(transcript, indent=2)
    if len(output) > 100000:
        # Trim older messages, keep last N
        while len(json.dumps(transcript, indent=2)) > 100000 and len(transcript) > 10:
            transcript.pop(0)
        output = json.dumps(transcript, indent=2)

    print(output)


def flag_current(args):
    db = get_db()
    cur = db.execute(
        """SELECT id, title FROM session
           WHERE title LIKE ?
           ORDER BY time_created DESC
           LIMIT 1""",
        (f"%{args.agent}%",),
    )
    row = cur.fetchone()
    if not row:
        print(json.dumps({"error": f"No sessions found for agent '{args.agent}'"}))
        sys.exit(1)

    session_id, title = row
    from datetime import datetime, timezone

    now = datetime.now(timezone.utc).isoformat()

    # Upsert: update if already flagged, otherwise insert
    existing = db.execute(
        "SELECT id FROM flagged_sessions WHERE session_id = ? AND resolved = 0",
        (session_id,),
    ).fetchone()

    if existing:
        db.execute(
            "UPDATE flagged_sessions SET blocker_reason = ?, flagged_at = ? WHERE id = ?",
            (args.reason, now, existing[0]),
        )
    else:
        db.execute(
            "INSERT INTO flagged_sessions (session_id, agent_name, blocker_reason, flagged_at) VALUES (?, ?, ?, ?)",
            (session_id, args.agent, args.reason, now),
        )
    db.commit()
    print(
        json.dumps(
            {
                "status": "flagged",
                "session_id": session_id,
                "title": title,
                "agent": args.agent,
                "reason": args.reason,
                "flagged_at": now,
            },
            indent=2,
        )
    )


def list_flagged(args):
    db = get_db()
    where = ""
    if args.pending_only:
        where = "WHERE f.resolved = 0"
    elif args.resolved_only:
        where = "WHERE f.resolved = 1"

    cur = db.execute(
        f"""SELECT f.session_id, f.agent_name, f.blocker_reason, f.flagged_at,
                   f.resolved, f.resolved_at, f.notes, s.title
            FROM flagged_sessions f
            LEFT JOIN session s ON s.id = f.session_id
            {where}
            ORDER BY f.flagged_at DESC""",
    )
    rows = [
        {
            "session_id": r[0],
            "agent_name": r[1],
            "blocker_reason": r[2],
            "flagged_at": r[3],
            "resolved": bool(r[4]),
            "resolved_at": r[5],
            "notes": r[6],
            "title": r[7],
        }
        for r in cur.fetchall()
    ]
    print(json.dumps(rows, indent=2))


def resolve_flagged(args):
    db = get_db()
    from datetime import datetime, timezone

    now = datetime.now(timezone.utc).isoformat()

    cur = db.execute(
        "UPDATE flagged_sessions SET resolved = 1, resolved_at = ?, notes = ? WHERE session_id = ? AND resolved = 0",
        (now, args.notes, args.session_id),
    )
    db.commit()
    if cur.rowcount == 0:
        print(
            json.dumps(
                {"error": f"No pending flag found for session '{args.session_id}'"}
            )
        )
        sys.exit(1)
    print(
        json.dumps(
            {"status": "resolved", "session_id": args.session_id, "resolved_at": now},
            indent=2,
        )
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--reconfigure",
        "--setup",
        action="store_true",
        help="Re-run interactive DB setup even if already configured",
    )
    sub = parser.add_subparsers(dest="cmd")

    ls = sub.add_parser("list")
    ls.add_argument("--search", default="regress")
    ls.add_argument("--limit", type=int, default=20)

    tr = sub.add_parser("transcript")
    tr.add_argument("session_id")

    fc = sub.add_parser(
        "flag-current", help="Flag the most recent session for an agent"
    )
    fc.add_argument(
        "--agent", required=True, help="Agent name (e.g., regression-writer)"
    )
    fc.add_argument("--reason", required=True, help="Blocker reason")

    lf = sub.add_parser("list-flagged", help="List sessions flagged for review")
    lf.add_argument("--pending-only", action="store_true")
    lf.add_argument("--resolved-only", action="store_true")

    rs = sub.add_parser("resolve", help="Mark a flagged session as resolved")
    rs.add_argument("session_id")
    rs.add_argument("--notes", default=None, help="Resolution notes")

    args = parser.parse_args()
    if args.reconfigure:
        run_setup()
        return
    if args.cmd == "list":
        list_sessions(args)
    elif args.cmd == "transcript":
        get_transcript(args)
    elif args.cmd == "flag-current":
        flag_current(args)
    elif args.cmd == "list-flagged":
        list_flagged(args)
    elif args.cmd == "resolve":
        resolve_flagged(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
