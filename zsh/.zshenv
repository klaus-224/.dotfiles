export DOTFILES_HOME="${DOTFILES_HOME:-$HOME/.dotfiles}"

## codex cli config
export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export CODEX_CONFIG_FILE="${CODEX_CONFIG_FILE:-$CODEX_HOME/config.toml}"

## Copilot cli config
export COPILOT_HOME="${COPILOT_HOME:-$HOME/.copilot}"
export COPILOT_CONFIG_FILE="${COPILOT_CONFIG_FILE:-$COPILOT_HOME/config.json}"
export COPILOT_PROFILES_DIR="${COPILOT_PROFILES_DIR:-$COPILOT_HOME/config.json}"
export COPILOT_MCP_CONFIG_FILE="${COPILOT_MCP_CONFIG_FILE:-$COPILOT_HOME/mcp-config.json}"

## General stuff I like
export EDITOR="nvim"
export PAGER="nvim +Man!"
